# ==========================================
# ParkFlow Environment Variables (Vercel & Local)
# ==========================================

# Supabase Project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Keep private! Used ONLY server-side by /api/ingest)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Public Anon Key (Used by client-side browser via /api/config)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Device Ingest Bearer Token (Shared secret between ESP32/Wokwi and /api/ingest)
DEVICE_INGEST_TOKEN=your-random-32-byte-hex-token
